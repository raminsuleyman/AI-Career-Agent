# ==========================================
# AI Career Agent — Environment Variables
# ==========================================
# Copy this file to .env and fill in values

# App
NODE_ENV=production
PORT=3000

# Database (MySQL)
DATABASE_URL=mysql://user:password@host:3306/dbname

# JWT Secret (random string, min 32 chars)
MANUS_JWT_SECRET=your-super-secret-jwt-key-here

# AI API (Gemini / OpenAI)
MANUS_API_URL=https://api.manus.ai
MANUS_API_KEY=your-api-key-here

# OAuth (optional - Manus)
MANUS_OAUTH_API_URL=
MANUS_PROJECT_ID=
OWNER_OPEN_ID=

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
APP_BASE_URL=https://ai-career-agent-production-a88b.up.railway.app
